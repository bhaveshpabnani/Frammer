# ── Supabase / Postgres ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Direct async Postgres URL (Supabase → Settings → Database → Connection string → URI)
# Format: postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Supabase project URL and anon key (for Auth validation)
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173

# ── CSV Data Path ──────────────────────────────────────────────────────────────
# Path to the "Frammer Data" folder containing the 11 CSV files
CSV_DATA_PATH=../Frammer Data
